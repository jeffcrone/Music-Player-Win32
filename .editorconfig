root = true

[*]
charset = utf-8
indent_style = tab
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML forbids tab characters in indentation, so the GitHub workflow files
# have to use spaces. This is the one exception to the tabs rule.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Trailing double spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Vendored third-party code keeps the upstream formatting.
[third_party/**]
indent_style = unset
tab_width = unset
trim_trailing_whitespace = unset
